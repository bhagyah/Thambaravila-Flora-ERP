  userId    String?  @map("user_id")
  roleName  String?  @map("role_name")
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, URGENT
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

/// Business work schedule configuration — single-row table (upserted on save).
/// Defines the standard working week used to calculate expected hours and
/// attendance compliance for all staff. Configurable by Owner and IT/Admin.
model WorkScheduleConfig {
  id            String   @id @default("default")
  /// Comma-separated day numbers: 1=Mon,2=Tue,3=Wed,4=Thu,5=Fri,6=Sat,7=Sun
  /// Default "1,2,3,4,5,6" = Mon–Sat
  workingDays   String   @default("1,2,3,4,5,6") @map("working_days")
  /// 24-hour start time, e.g. "09:00"
  workStartTime String   @default("09:00") @map("work_start_time")
  /// 24-hour end time, e.g. "17:00"
  workEndTime   String   @default("17:00") @map("work_end_time")
  /// Grace period in minutes before clock-in is marked late
  graceMinutes  Int      @default(15) @map("grace_minutes")
  updatedById   String?  @map("updated_by_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("work_schedule_configs")
}

