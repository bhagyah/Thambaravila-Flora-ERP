// ========================================
// GEOFENCE & ATTENDANCE MODELS
// ========================================

/// Represents a named geographic zone used to validate attendance check-ins.
/// IT/Owner managed. Supports multiple simultaneous active zones (e.g. shop + warehouse + WFH).
/// NOTE: This is best-effort geofencing. Browser GPS can be spoofed by
/// fake-location apps. This system prevents accidental off-site check-ins
/// and provides a verifiable record, but is not tamper-proof.
model Geofence {
  id              String   @id @default(cuid())
  name            String // e.g. "Main Shop", "Warehouse", "Prasangika Home Geozone"
  centerLatitude  Float    @map("center_latitude")
  centerLongitude Float    @map("center_longitude")
  radiusMeters    Int      @map("radius_meters") // The acceptance circle radius in metres
  isActive        Boolean  @default(true) @map("is_active") // IT can disable without deleting
  isMain          Boolean  @default(false) @map("is_main") // Main workplace zone (applies to all roles)
  zoneType        String   @default("MAIN") @map("zone_type") // "MAIN" | "WFH" | "ON_SITE"
  allowedRoles    String?  @map("allowed_roles") // Comma-separated role names e.g. "Wedding Coordinator,Social Media Manager"
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  workSessions     WorkSession[]
  rejectedAttempts AttendanceAttemptLog[]

  @@index([isActive])
  @@index([isMain])
  @@index([zoneType])
  @@map("geofences")
}

/// Audit log for every attendance attempt — successful or rejected.
/// Rejected attempts (outside zone, weak GPS) are still recorded for IT review.
/// This allows IT/Owner to spot repeated failed attempts or spoofing patterns.
model AttendanceAttemptLog {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  userName          String    @map("user_name")
  action            String // "CLOCK_IN" | "CLOCK_OUT"
  latitude          Float?
  longitude         Float?
  accuracyMeters    Float?    @map("accuracy_meters")
  result            String // "SUCCESS" | "REJECTED_OUTSIDE_ZONE" | "REJECTED_WEAK_GPS" | "REJECTED_NO_LOCATION"
  rejectionReason   String?   @map("rejection_reason")
  nearestGeofenceId String?   @map("nearest_geofence_id")
  nearestGeofence   Geofence? @relation(fields: [nearestGeofenceId], references: [id])
  nearestDistanceM  Float?    @map("nearest_distance_m") // Distance to closest zone centre
  workSessionId     String?   @map("work_session_id") // Set only on SUCCESS
  deviceInfo        String?   @map("device_info")
  timestamp         DateTime  @default(now())

  @@index([userId])
  @@index([result])
  @@index([timestamp])
  @@map("attendance_attempt_logs")
}

/// Manual session override by IT/Owner. Required when GPS failure prevented
/// a valid check-in on a legitimate work day. Fully audited.
model WorkSessionOverride {
  id               String   @id @default(cuid())
  workSessionId    String   @map("work_session_id")
  overriddenById   String   @map("overridden_by_id")
  overriddenByName String   @map("overridden_by_name")
  reason           String // Mandatory — explains why override was needed
  originalData     String   @map("original_data") // JSON snapshot of original session
  newData          String   @map("new_data") // JSON snapshot of corrected session
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([workSessionId])
  @@map("work_session_overrides")
}

model Notification {
